# ==============================================================================
# Society Event Management - Environment Configuration
# ==============================================================================
# Set REACT_APP_ENV to:
#   - 'local' : Uses localhost backend (http://localhost:6090/api/v1)
#   - 'stage' : Uses staging backend (https://api-societymgmt.anaxistech.com/api/v1)
#   - 'live'  : Uses production backend (https://api-societymgmt.anaxistech.com/api/v1)
# ==============================================================================
REACT_APP_ENV=local

# Optional: Manually override the API Base URL (if set, this overrides the default URL for any environment)
# REACT_APP_API_URL=http://localhost:6090/api/v1
# REACT_APP_API_URL=https://api-societymgmt.anaxistech.com/api/v1

# Optional Application Metadata & Settings
REACT_APP_NAME="Society Event Management"
REACT_APP_VERSION="1.0.0"
REACT_APP_API_TIMEOUT=30000

# Build settings
DISABLE_ESLINT_PLUGIN=true
