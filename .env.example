# ==============================================================================
# Environment Configuration (.env.example)
# ==============================================================================
# Supported Environments:
# - local : Local development server
# - stage : Staging / QA pre-release environment
# - live  : Production client-facing environment
# ==============================================================================

# Current active environment: local | stage | live
REACT_APP_ENV=local

# Optional API URL override (if omitted, defaults to preset for REACT_APP_ENV)
# Local: http://localhost:5000/api
# Stage: https://stage-api.societyevents.com/api
# Live:  https://api.societyevents.com/api
REACT_APP_API_URL=http://localhost:5000/api

# API Request timeout in milliseconds (default: 15000)
REACT_APP_API_TIMEOUT=15000

# Application Branding & Metadata
REACT_APP_NAME="Society Event Management"
REACT_APP_VERSION="1.0.0"
