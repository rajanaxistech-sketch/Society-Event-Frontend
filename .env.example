# ==============================================================================
# Society Event Management - Environment Configuration Template
# ==============================================================================
# Switch environments by setting REACT_APP_ENV to 'local' or 'stage'
#
# REACT_APP_ENV=local  -> Uses http://localhost:6090/api/v1
# REACT_APP_ENV=stage  -> Uses https://api-societymgmt.anaxistech.com/api/v1
# ==============================================================================
REACT_APP_ENV=local

# Custom API base URL override (optional)
# REACT_APP_API_URL=https://api-societymgmt.anaxistech.com/api/v1

# App configuration
REACT_APP_NAME="Society Event Management"
REACT_APP_VERSION="1.0.0"
REACT_APP_API_TIMEOUT=30000

# Build settings
DISABLE_ESLINT_PLUGIN=true
